   "source": [
    "from functools import cache\n",
    "\n",
    "@cache\n",
    "def climbStairs(n):\n",
    "    if n <= 2:\n",
    "        return n\n",
    "    return climbStairs(n - 1) + climbStairs(n - 2)\n",
    "\n",
    "climbStairs(10)"
   ]
  }
 ],
